<UserControl x:Class="CalculatorApp.EngineeringCalculator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:CalculatorApp.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CalculatorApp.ViewModel"
             d:DesignHeight="600"
             d:DesignWidth="400"
             mc:Ignorable="d">

    <!--
        Page for the multi-field calculators (Electric power, Ohm's law, Mechanical power).
        Fill in all but one field and the remaining one is calculated.
    -->

    <UserControl.Resources>
        <converters:BooleanToVisibilityNegationConverter x:Key="BooleanToVisibilityNegationConverter"/>

        <DataTemplate x:Key="FieldTemplate" x:DataType="vm:EngineeringField">
            <Grid Margin="0,6" ColumnSpacing="8">
                <!-- Proportional columns so the row still fits a narrow (~320 px) window -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*" MinWidth="72"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Text="{x:Bind Label}"
                           TextWrapping="WrapWholeWords"/>

                <TextBox Grid.Column="1"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="{x:Bind Label}"
                         InputScope="Number"
                         IsSpellCheckEnabled="False"
                         Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextAlignment="Right"/>

                <ComboBox Grid.Column="2"
                          MinWidth="92"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{x:Bind Label}"
                          ItemsSource="{x:Bind UnitNames}"
                          SelectedIndex="{x:Bind SelectedUnitIndex, Mode=TwoWay}"
                          Visibility="{x:Bind HasUnitChoice}"/>
                <TextBlock Grid.Column="2"
                           MinWidth="92"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Text="{x:Bind SingleUnitName}"
                           Visibility="{x:Bind HasUnitChoice, Converter={StaticResource BooleanToVisibilityNegationConverter}}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Top margin = HamburgerHeight: MainPage draws the mode header over the top 48 px of the page. -->
    <ScrollViewer Margin="0,48,0,0"
                  HorizontalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Content"
                    MaxWidth="560"
                    Margin="16,4,16,16"
                    HorizontalAlignment="Stretch"
                    Spacing="4">

            <Grid Margin="0,0,0,8"
                  ColumnSpacing="8"
                  Visibility="{x:Bind ViewModel.HasOptions, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Text="{x:Bind ViewModel.OptionsLabel, Mode=OneWay}"/>
                <ComboBox Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{x:Bind ViewModel.OptionsLabel, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.Options, Mode=OneWay}"
                          SelectedIndex="{x:Bind ViewModel.SelectedOptionIndex, Mode=TwoWay}"/>
            </Grid>

            <ItemsControl x:Name="FieldList"
                          IsTabStop="False"
                          ItemTemplate="{StaticResource FieldTemplate}"
                          ItemsSource="{x:Bind ViewModel.Fields, Mode=OneWay}"/>

            <TextBlock Margin="0,8,0,0"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"/>
            <TextBlock Margin="0,8,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       IsTextSelectionEnabled="True"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Text="{x:Bind ViewModel.NotesText, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Visibility="{x:Bind ViewModel.HasNotes, Mode=OneWay}"/>

            <Button Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    Command="{x:Bind ViewModel.ClearCommand, Mode=OneWay}"
                    Content="Clear"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
